# ============================================================================
# SDS Safety Assistant — пример конфигурации окружения.
# Скопируйте в .env (`cp .env.example .env`) и при необходимости поправьте.
# Все переменные читаются сервисом через os.getenv (см. engine/service.py,
# engine/retriever.py, engine/backends.py, engine/qdrant_index.py).
#
# Файлы данных (CORPUS_FILE/EMB_FILE/IDS_FILE/SUBS_FILE) — это ИМЕНА файлов
# внутри папки data/ (она монтируется/копируется как ../data относительно engine/).
# Указывать полный путь не нужно — только имя файла.
# ============================================================================

# --- Retrieval (поиск релевантных разделов паспортов безопасности) ---------
# lexical  — офлайн, без модели, без Ollama. Дефолт для демо «из коробки».
# semantic — bge-m3 через локальный Ollama + плант-скоуп. ПРОД on-prem (КИИ).
# qdrant   — то же, но через локальный Qdrant (профиль qdrant в compose). Опционально.
RETRIEVER=semantic

# --- Реранк (опционально, только поверх semantic) --------------------------
# 0 — выключен (дефолт). 1 — включить кросс-энкодер/LLM-реранк.
RERANK=0
# crossencoder — bge-reranker-v2-m3 (быстрый). llm — через локальный Ollama (air-gapped, медленнее).
RERANK_BACKEND=crossencoder
RERANK_N=20

# --- Генерация ответа (LLM) -------------------------------------------------
# extractive — без модели, собирает ответ из найденных разделов с цитатами.
#              Нулевой риск галлюцинаций. Дефолт для демо без Ollama.
# ollama     — qwen2.5:7b через ЛОКАЛЬНЫЙ Ollama. ПРОД on-prem (КИИ).
LLM_BACKEND=ollama
OLLAMA_LLM=qwen2.5:7b

# --- Хост Ollama ------------------------------------------------------------
# Ollama работает НА ХОСТЕ железа завода (порт 11434), НЕ внутри контейнера.
# В контейнере localhost = сам контейнер, поэтому обращаемся к хосту по
# host.docker.internal (см. extra_hosts в docker-compose.yml).
# Запуск без контейнера (python -m uvicorn ...): ставьте http://127.0.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434
# Модель эмбеддингов (для semantic/qdrant retrieval). Совпадает с моделью индексации.
EMBED_MODEL=bge-m3

# --- Файлы данных (внутри data/) -------------------------------------------
# Прод-набор (очищенный): полный корпус + эмбеддинги bge-m3.
CORPUS_FILE=corpus_full_clean.json
EMB_FILE=embeddings_clean.npy
IDS_FILE=embed_ids_clean.json
SUBS_FILE=substances_clean.json

# --- Порог воздержания (abstain) -------------------------------------------
# Ниже порога уверенности сервис честно отвечает «в базе нет данных», а не выдумывает.
# Цена ошибки в химбезопасности — здоровье человека, поэтому порог консервативный.
ABSTAIN_THRESHOLD=0.62

# --- Аутентификация (defense-in-depth) -------------------------------------
# Пусто = выкл (демо и закрытый КИИ-контур). Если задано — все запросы, кроме
# /health и статики UI, требуют заголовок X-API-Key. Это СТОПГАП: основная
# аутентификация на проде — обратный прокси с AD/LDAP предприятия (DEPLOY.md).
API_KEY=

# --- Ротация аудит-лога (data/audit_log.jsonl) -----------------------------
# Чтобы лог не рос безгранично: при превышении размера — ротация поколений.
AUDIT_LOG_MAX_BYTES=52428800
AUDIT_LOG_KEEP=3

# --- Qdrant (только при RETRIEVER=qdrant, профиль `qdrant` в compose) -------
# Адрес Qdrant для сервиса. По умолчанию локальный embedded-режим (data/qdrant_local),
# но при использовании контейнера Qdrant укажите http://qdrant:6333.
# QDRANT_PATH и QDRANT_COLLECTION читаются engine/qdrant_index.py.
QDRANT_COLLECTION=sds

# ============================================================================
# ПРОФИЛИ ИСПОЛЬЗОВАНИЯ
# ----------------------------------------------------------------------------
# ДЕМО (без Ollama, всё офлайн «из коробки»):
#   RETRIEVER=lexical
#   LLM_BACKEND=extractive
#
# ПРОД КИИ / on-prem (air-gapped, локальный Ollama на железе завода):
#   RETRIEVER=semantic
#   LLM_BACKEND=ollama
#   OLLAMA_HOST=http://host.docker.internal:11434
#   RERANK=1   (рекомендуется: кросс-энкодер поднимает точность top-1 ~89%->92%;
#               нужен реранкер-модель, иначе сервис мягко работает без него)
#   (Qdrant — опционально, профилем; по умолчанию хватает semantic на .npy)
#
# В прод-контур переносится ТОЛЬКО готовая папка data/. Никаких внешних
# сетевых вызовов на рантайме — см. DEPLOY.md, раздел «Офлайн-гарантия / air-gap».
# ============================================================================
