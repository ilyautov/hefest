# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- OS / редакторы ---
.DS_Store
*.swp

# --- Секреты (шаблон .env.example остаётся в репозитории) ---
.env

# --- Генерируемые артефакты (восстанавливаются из corpus) ---
# Векторные эмбеддинги — ~300M, пересоздаются скриптами build_corpus/ingest.
# Канонический embeddings_clean.npy хранится через Git LFS (см. .gitattributes),
# остальные .npy (бэкапы, не-clean) — исключены.
*.npy
!data/embeddings_clean.npy

# --- Резервные копии данных ---
*.bak
*.bak.*

# --- Рантайм-состояние сервиса ---
data/audit_log.jsonl
*.log

# --- Локальный векторный индекс Qdrant (~275M, пересоздаётся) ---
data/qdrant_local/

# --- Артефакты QA/отладки ---
.playwright-mcp/
screenshots/
arch-doc.png

# --- Презентационные PDF: артефакты сборки (в репо только шаблоны+скрипты) ---
docs/brochure/*.pdf
docs/brochure/*_embed.html

# --- Тяжёлые исходные справочники (входной материал, не код) ---
# Хранятся вне VCS; при необходимости — Git LFS
engine/*.pdf
engine/*.htm.html

# --- Локальное состояние агентов/редакторов ---
.claude/
.codex/

# --- Промежуточные артефакты конвейера данных (пересоздаются) ---
# corpus_full.json  -> предочистной корпус, пересобирается: python3 engine/corpus.py
# embed_ids.json    -> идентификаторы доочистного индекса, пересобираются вместе с ним
# Канонические (нужны для запуска) — corpus_full_clean.json и embed_ids_clean.json — трекаются.
data/corpus_full.json
data/embed_ids.json

# --- Приватные материалы владельца (денайлист организаций для scripts/guard.sh) ----
.private/

# --- Реестр предприятий: в публичную поставку НЕ входит ---------------------------
# Публичный репозиторий не содержит сведений о юридических лицах (см. DATA-LICENSE.md,
# раздел 4). Реестр — приватные данные внедрения: он остаётся в контуре пользователя.
# В репозитории публикуется только схема с вымышленным примером: data/plants.example.json.
data/plants.json
data/plants_linked.json
data/plant_aliases.json
data/plants_demo.json
data/plants_linked_demo.json
data/plants_local*.json

# --- Сгенерированный showcase-UI (engine/generate_ui.py) ---
index_pro.html

# --- Исходники нормативных документов (объёмны, общедоступны у первоисточника) ---
# См. DATA-LICENSE.md, раздел 1: в репозиторий не включаются, скрипты ингеста берут их путём.
data/sources/
